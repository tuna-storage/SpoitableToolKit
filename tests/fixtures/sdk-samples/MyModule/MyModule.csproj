<Project Sdk="Microsoft.NET.Sdk">

  <!--
    repo の外に置いたモジュールの見本。SdkPackageTests が置き場へ写して、パッケージ SpoitableToolKit.Sdk だけを入れ元に build する。
    この repo の解には入れていない（ここでは build しない）。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.3.0</Version>
    <SpoitableModuleId>mymodule</SpoitableModuleId>
    <!-- 名前には、build が作るファイル（JSON・C#）と MSBuild の項目で意味を持つ字を、わざと入れてある。 -->
    <SpoitableModuleName>心拍; "x" \ 50% it's (a) *? @(b)</SpoitableModuleName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本物のモジュールは、ここに版を数字で書く。試験は、いま作ったパッケージの版を置き場の Directory.Build.props から渡す。 -->
    <PackageReference Include="SpoitableToolKit.Sdk" Version="$(SpoitableSdkVersionUnderTest)" />
  </ItemGroup>

</Project>
