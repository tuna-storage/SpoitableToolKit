<Project Sdk="Microsoft.NET.Sdk">

  <!--
    モジュールどうしで渡す API の契約（interface だけの dll）の見本。渡す側（GreeterModule）と使う側（GreeterUser）が参照する。
    SdkPackageTests が置き場へ写して build する。この repo の解には入れていない。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- モジュールではなく契約。Id も名前も要らない。参照する側は、どちらの側かを SpoitableContract で書く。 -->
    <SpoitableProjectKind>Contract</SpoitableProjectKind>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本物の project は、ここに版を数字で書く。試験は、いま作ったパッケージの版を置き場の Directory.Build.props から渡す。 -->
    <PackageReference Include="SpoitableToolKit.Sdk" Version="$(SpoitableSdkVersionUnderTest)" />
  </ItemGroup>

</Project>
